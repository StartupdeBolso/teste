# Symfony
APP_ENV=dev
APP_SECRET=change_this_to_a_random_secret

# Database (Supabase)
# Get this from your Supabase project settings
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_this_passphrase

# Google Sheets API
# Download credentials JSON from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=%kernel.project_dir%/config/google-credentials.json

# N8N Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-hook-id

# CORS (Vercel frontend)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|.*\.vercel\.app)(:[0-9]+)?$'
